        <item/>
        <item/>
        <item/>
        <item/>
        <item/>
        <item>ጣትዎን ያንቀሳቅሱት። እንደገና ይሞክሩ።</item>
        <item>ጣት አስቀድሞ ተመዘገበ ነው፣ የተለየ ጣት ይጠቀሙ።</item>
        <item>ደካማ የምስል ጥራት። እንደገና ይሞክሩ።</item>
        <item/>
        <item>ደካማ የምስል ጥራት። እንደገና ይሞክሩ።</item>
        <item/>
        <item/>
        <item>ጉድፍ ተገኝቷል፣ ማያ ገጽን ያጽዱ። እንደገና ይሞክሩ።</item>
        <item>ምስልን ማንበብ አልተሳካም። እንደገና ይሞክሩ።</item>
        <item/>
    </string-array>

    <!-- Generic error message shown when fingerprint needs calibration [CHAR LIMIT=150] -->
    <string name="fingerprint_error_bad_calibration">የጣት አሻራ ዳሳሽን መጠቀም አይቻልም። የጥገና አገልግሎት ሰጪን ወይም g.co/pixel/fingerprintunlock ይጎብኙ</string>

    <!-- Notification content shown when the system requires the user to re-calibrate their fingerprint. [CHAR LIMIT=NONE] -->
    <string name="fingerprint_recalibrate_notification_content">የጥገና አገልግሎት ሰጪን ወይም g.co/pixel/fingerprintunlock ይጎብኙ</string>
</resources>
